{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [{"path": "/api/maintenance/research-dispatch", "schedule": "0 3 * * *"}],
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "npm install --prefix ../.."
    },
    "api": {
      "root": "apps/api",
      "entrypoint": "pyproject.toml",
      "functions": {
        "**/*": {
          "maxDuration": 300
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
