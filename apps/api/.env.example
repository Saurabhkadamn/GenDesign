SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
MODEL_ENCRYPTION_KEY=
FORMA_ALLOWED_ORIGINS=https://forma-cad-eosin.vercel.app
# VERCEL_ENV supplies preview/production isolation; never accept this from a browser.
OPENROUTER_FREE_ONLY=false
OPENROUTER_NEMOTRON_TESTING=true
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MAX_OUTPUT_TOKENS=32768
# NVIDIA uses SSE by default; set false to force buffered responses.
OPENAI_COMPATIBLE_STREAM=
# NVIDIA testing fallback: Kimi-K3 is primary; Nemotron is tried after a
# definitive overload, quota, rate-limit, or access failure.
OPENAI_COMPATIBLE_FALLBACK_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b
# Optional JSON merged into compatible-provider requests, e.g.
# {"chat_template_kwargs":{"thinking":false}}
OPENAI_COMPATIBLE_EXTRA_BODY_JSON=
FORMA_RESOURCE_BUDGETS=true
CAD_RUNTIME_SNAPSHOT_ID=
CAD_RUNTIME_VERSION=
# Sandbox uses server OIDC automatically. No Docker or local CAD process.
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require
LANGGRAPH_STRICT_MSGPACK=true
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pr-potable-icicle-84
